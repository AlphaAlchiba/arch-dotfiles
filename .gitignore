# Secrets — never commit API keys or passwords
# opencode.jsonc is committed; API keys are referenced via {env:...} placeholders.
.opencode-secrets

# OS junk
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Editor artifacts
.venv/
__pycache__/
node_modules/
.ruff_cache/

# Machine-specific monitor rules (serial numbers / port layout)
config/hypr/modules/monitors.local.lua
config/hypr/modules/monitors_local.lua

# Brain_Shell runtime state (rewritten by Quickshell)
config/Brain_Shell/user_data/*.json
config/Brain_Shell/src/user_data/*.json
