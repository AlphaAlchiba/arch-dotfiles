{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "auto",
    "height": 18
  },

  "display": {
    "separator": " : "
  },

  "modules": [
    {
      "type": "command",
      "key": "  ",
      "keyColor": "blue",
      "text": "hyprctl splash"
    },

    {
      "type": "custom",
      "format": "┌──────────────────────────────────────────┐"
    },

    {
      "type": "host",
      "key": "  󰇺 Host",
      "keyColor": "blue"
    },

    {
      "type": "os",
      "key": "  󰣇 OS",
      "format": "{2}",
      "keyColor": "red"
    },

    {
      "type": "kernel",
      "key": "   Kernel",
      "format": "{2}",
      "keyColor": "red"
    },

    {
      "type": "packages",
      "key": "  󰏗 Packages",
      "keyColor": "green"
    },

    {
      "type": "display",
      "key": "  󰍹 Display",
      "format": "{1}x{2} @ {3}Hz",
      "keyColor": "green"
    },

    {
      "type": "terminal",
      "key": "   Terminal",
      "keyColor": "yellow"
    },

    {
      "type": "wm",
      "key": "  󱗃 WM",
      "format": "{2}",
      "keyColor": "yellow"
    },

    {
      "type": "custom",
      "format": "└──────────────────────────────────────────┘"
    },

    "break",

    {
      "type": "title",
      "format": "{6}@{7}"
    },

    {
      "type": "custom",
      "format": "┌──────────────────────────────────────────┐"
    },

    {
      "type": "cpu",
      "key": "   CPU",
      "format": "{1} ({3}C/{4}T) @ {7}",
      "keyColor": "blue"
    },

    {
      "type": "gpu",
      "key": "  󰊴 GPU",
      "format": "{1} {2}",
      "keyColor": "blue"
    },

    {
      "type": "memory",
      "key": "   Memory",
      "keyColor": "magenta"
    },

    {
      "type": "disk",
      "folders": "/",
      "key": "  󰋊 Root FS",
      "keyColor": "magenta"
    },

    {
      "type": "uptime",
      "key": "  󱫐 Uptime",
      "keyColor": "red"
    },

    {
      "type": "localip",
      "key": "  󰩠 Local IP",
      "keyColor": "cyan"
    },

    {
      "type": "publicip",
      "key": "  🌍 Public IP",
      "keyColor": "cyan"
    },

    {
      "type": "shell",
      "key": "   Shell",
      "keyColor": "yellow"
    },

    {
      "type": "custom",
      "format": "└──────────────────────────────────────────┘"
    },

    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
