{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin",
    "mode": "dark"
  },
  "tabs": {
    "mode": "off",
    "layout": "horizontal",
    "indicators": "status",
    "scope": "cwd"
  },
  "keybinds": {
    "agent.cycle": "tab",
    "agent.cycle.reverse": "shift+tab"
  },
  "animations": true,
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show",
    "new_location": "launch"
  },
  "prompt": {
    "image_preview": true
  },
  "attention": {
    "notifications": false
  },
  "terminal": {
    "title": true,
    "copy": "select"
  }
}
