# Zathura — Catppuccin Mocha
# Colors match the rest of the desktop; adjust to taste.

set default-bg                  "#1e1e2e"
set default-fg                  "#cdd6f4"
set statusbar-bg                "#181825"
set statusbar-fg                "#cdd6f4"
set inputbar-bg                 "#1e1e2e"
set inputbar-fg                 "#cdd6f4"
set notification-bg             "#f38ba8"
set notification-fg             "#1e1e2e"
set notification-error-bg       "#f38ba8"
set notification-error-fg       "#1e1e2e"
set notification-warning-bg     "#f9e2af"
set notification-warning-fg     "#1e1e2e"
set completion-bg               "#181825"
set completion-fg               "#cdd6f4"
set completion-highlight-bg     "#585b70"
set completion-highlight-fg     "#cdd6f4"
set completion-group-bg         "#1e1e2e"
set completion-group-fg         "#89b4fa"

# Invert PDF pages for a dark reading experience while keeping image hues.
set recolor                     true
set recolor-keephue             true
set recolor-darkcolor           "#cdd6f4"
set recolor-lightcolor          "#1e1e2e"

set selection-clipboard         clipboard
set adjust-open                 width
set scroll-page-aware          true
set scroll-step                 50
set smooth-scroll              true
set incremental-search         true
set link-zoom                   true
set zoom-min                    10
set zoom-max                    1000
set page-padding                4
set statusbar-h-padding         8
set statusbar-v-padding         8
set font                        "JetBrainsMono Nerd Font 10"
set guioptions                  "s"
