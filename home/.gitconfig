[user]
	name = alpha
	email = 170642770+AlphaAlchiba@users.noreply.github.com

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	features = catppuccin-mocha
	navigate = true
	line-numbers = true
	side-by-side = false

[delta "catppuccin-mocha"]
	syntax-theme = Catppuccin Mocha

[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default
