#!/usr/bin/env bash

SESSION="ideavault"
ROOT="$HOME/projects/ideavault/"

# Detect terminal size so we can set window dimensions BEFORE splitting.
# This prevents tmux from distributing the attach-resize delta evenly,
# which would destroy -l percentage proportions.
COLS=$(tput cols)
ROWS=$(tput lines)

tmux has-session -t "$SESSION" 2>/dev/null

if [ $? != 0 ]; then
  # ── Window: django ─────────────────────────────────────────
  tmux new-session -d -s "$SESSION" -n "django" -c "$ROOT"
  tmux resize-window -t "$SESSION:django" -x "$COLS" -y "$ROWS"
  tmux send-keys -t "$SESSION:django.1" "nvim" C-m
  sleep 0.5   # let nvim finish startup before split
  tmux split-window -h -l 30% -t "$SESSION:django" -c "$ROOT"
  tmux send-keys -t "$SESSION:django.2" "opencode" C-m
  sleep 0.5   # let opencode settle before next split
  tmux split-window -v -l 20% -t "$SESSION:django.1" -c "$ROOT"
  sleep 1.5  # let terminal settle before select-pane triggers focus event
  tmux select-pane -t "$SESSION:django.1"

  # ── Window: opencode ───────────────────────────────────────
  tmux new-window -t "$SESSION" -n "opencode" -c "$ROOT"
  tmux resize-window -t "$SESSION:opencode" -x "$COLS" -y "$ROWS"
  tmux send-keys -t "$SESSION:opencode.1" "opencode" C-m

  # ── Move root windows to higher indices ─────────────────────
  tmux move-window -s "$SESSION:opencode" -t "$SESSION:8"

  # ── Start on the django window ─────────────────────────────
  tmux select-window -t "$SESSION:django"
fi

tmux attach -t "$SESSION"
