#!/usr/bin/env bash
# Generated by tmux-session export; edit the YAML spec, not this file.
set -u

SESSION=dotfiles
COLS=$(tput cols 2>/dev/null || echo 80)
ROWS=$(tput lines 2>/dev/null || echo 24)

if ! tmux has-session -t "$SESSION" 2>/dev/null; then
  tmux new-session -d -s dotfiles -n dotfiles -c /home/alpha/dotfiles/
  tmux resize-window -t dotfiles:dotfiles -x "$COLS" -y "$ROWS"
  tmux send-keys -t dotfiles:dotfiles.1 nvim C-m
  sleep 0.5
  tmux split-window -h -t dotfiles:dotfiles.1 -c /home/alpha/dotfiles/ -l 30%
  tmux send-keys -t dotfiles:dotfiles.2 opencode C-m
  sleep 0.5
  tmux split-window -v -t dotfiles:dotfiles.1 -c /home/alpha/dotfiles/ -l 20%
  sleep 1.5
  tmux select-pane -t dotfiles:dotfiles.1
  tmux select-window -t dotfiles:dotfiles
fi

if [ -n "${TMUX:-}" ]; then
  tmux switch-client -t "$SESSION"
else
  tmux attach -t "$SESSION"
fi
