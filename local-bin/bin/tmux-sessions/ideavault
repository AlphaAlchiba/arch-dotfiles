#!/usr/bin/env bash
# Generated by tmux-session export; edit the YAML spec, not this file.
set -u

SESSION=ideavault
COLS=$(tput cols 2>/dev/null || echo 80)
ROWS=$(tput lines 2>/dev/null || echo 24)

if ! tmux has-session -t "$SESSION" 2>/dev/null; then
  tmux new-session -d -s ideavault -n django -c /home/alpha/projects/ideavault/
  tmux resize-window -t ideavault:django -x "$COLS" -y "$ROWS"
  tmux send-keys -t ideavault:django.1 nvim C-m
  sleep 0.5
  tmux split-window -h -t ideavault:django.1 -c /home/alpha/projects/ideavault/ -l 30%
  tmux send-keys -t ideavault:django.2 opencode C-m
  sleep 0.5
  tmux split-window -v -t ideavault:django.1 -c /home/alpha/projects/ideavault/ -l 20%
  sleep 1.5
  tmux select-pane -t ideavault:django.1
  tmux new-window -t ideavault -n opencode -c /home/alpha/projects/ideavault/
  tmux move-window -s ideavault:opencode -t ideavault:8
  tmux resize-window -t ideavault:8 -x "$COLS" -y "$ROWS"
  tmux send-keys -t ideavault:8.1 opencode C-m
  sleep 0.5
  tmux select-window -t ideavault:django
fi

if [ -n "${TMUX:-}" ]; then
  tmux switch-client -t "$SESSION"
else
  tmux attach -t "$SESSION"
fi
